            },
            "url": {
              "raw": "{{base_url}}/register",
              "host": ["{{base_url}}"],
              "path": ["register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error message is correct', () => {",
                  "  pm.expect(pm.response.json().error).to.eql('Missing password');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
