      "name": "Users",
      "item": [
        {
          "name": "GET List Users (page 2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has data array', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.be.an('array');",
                  "  pm.expect(json.data.length).to.be.greaterThan(0);",
                  "});",
                  "pm.test('Each user has id, email, first_name', () => {",
                  "  pm.response.json().data.forEach(user => {",
                  "    pm.expect(user).to.have.all.keys('id', 'email', 'first_name', 'last_name', 'avatar');",
                  "  });",
                  "});",
                  "pm.test('Response time < 2000ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users?page=2",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "2"
                }
              ]
            }
          },
          "response": []
        },
